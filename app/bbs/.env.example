# Next app environment.
# Copy to .env.local for development. .env* is gitignored except this file.

# Base URL of the Sisi OS backend. Server-side only — deliberately not a
# NEXT_PUBLIC variable, so the browser never talks to the API directly and
# no internal host leaks into the bundle.
# Local:      http://127.0.0.1:8000
# Deployed:   https://api.<your-domain>
API_BASE_URL=http://127.0.0.1:8000
