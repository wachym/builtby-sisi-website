# Sisi OS backend — environment contract.
# Copy to .env for local development (.env is gitignored and must never be committed).
# Production sets these in the container host's secret store, not in a file.

# --- Django core -----------------------------------------------------------
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=bbsbackend.settings.dev
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# Comma-separated. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# sqlite:///db.sqlite3 for local convenience; postgres://... everywhere else.
# Docker Compose (infra/docker-compose.yml) provides:
#   postgres://sisi:sisi@localhost:5432/sisi
DATABASE_URL=sqlite:///db.sqlite3

# --- Frontend origins ------------------------------------------------------
# The Next app's origins. Allow-listed explicitly; never wildcarded.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Ledger ----------------------------------------------------------------
# When true, every appended event must carry a valid Ed25519 signature.
# False only for local development. Production sets this to true.
LEDGER_REQUIRE_SIGNATURES=false

# Ed25519 private key (hex) used by the system actor to sign events.
# Local development only — production signs through the isolated signer service.
# Generate: python manage.py ledger_keygen
LEDGER_SIGNING_KEY=
LEDGER_SIGNING_ACTOR=system

# Chain that ledger roots are anchored to. Testnet until Phase 5.
LEDGER_ANCHOR_CHAIN=base-sepolia

# --- Internal service auth -------------------------------------------------
# Comma-separated keys accepted in the X-Internal-Key header for writes.
# Placeholder until the accounts app owns real API keys (Phase 2).
INTERNAL_API_KEYS=

# --- Build metadata --------------------------------------------------------
# Set by CI so /system/version reports the deployed commit.
GIT_COMMIT_SHA=
