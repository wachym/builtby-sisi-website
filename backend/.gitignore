# Backend-scoped ignores. Root .gitignore covers the general cases;
# these exist so the backend stays clean even if it is used standalone.

# Virtualenvs — never commit these.
venv/
.venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local database and artifacts
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment
.env
.env.*
!.env.example

# Generated API contract (regenerated by `manage.py export_openapi`)
openapi.json

# Coverage
.coverage
htmlcov/
coverage.xml
